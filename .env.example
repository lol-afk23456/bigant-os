PORT=
DATA_DIR=

# Archivio credenziali: chiave casuale di 32 byte in base64, da impostare solo sul server.
# Non salvarne il valore in Git; conservarne una copia separata dai backup SQLite.
BIGANT_SECRET_KEY=

# Fornitori AI predisposti; lasciare vuoti fino a scelta di modello, budget e collaudo.
BIGANT_ANTHROPIC_API_KEY=
BIGANT_API_MODELLO=
BIGANT_API_COSTO_MAX_CENT=
BIGANT_OPENAI_API_KEY=
BIGANT_OPENAI_MODELLO=
BIGANT_OPENAI_COSTO_MAX_CENT=

# Growth reale: preparazione soltanto. Lasciali false fino al collaudo autorizzato.
# Anche con il flag servono configurazione, collaudo e attivazione del socio per fase.
BIGANT_GROWTH_EXTERNAL_ENABLED=false
BIGANT_GROWTH_GMAIL_ENABLED=false
# Calendar richiede anche Gmail, consenso Calendar esplicito e prova ricevuta dal socio.
BIGANT_GROWTH_CALENDAR_ENABLED=false

# GBP: consenso separato da Gmail, scelta scheda, prova e attivazione per attività.
# Lettura soltanto; cache in memoria fino a 24 ore. Nessuna risposta alle recensioni.
BIGANT_GBP_ENABLED=false

# Prove tecniche AI individuali: default spento, consenso e budget richiesti.
BIGANT_SCIAME_AI_TRIALS_ENABLED=false

# Percorso operativo social manuale: default spento, autorizzazione separata.
BIGANT_SCIAME_AI_ENABLED=false
